# Runtime mode: mock or fetch
API_MODE=mock

# Required when API_MODE=fetch. Production requires HTTPS.
API_BASE_URL=https://api.example.com
API_VERSION=v1
API_TIMEOUT=15000

# Public canonical origin, sitemap, robots, Open Graph.
SITE_URL=https://fuurin.reiyuura.pw

# Release identifier for health and monitoring context.
RELEASE=0.1.0

# Optional client-visible equivalents if browser-side transport is enabled.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_API_TIMEOUT_MS=15000
NEXT_PUBLIC_SITE_URL=https://fuurin.reiyuura.pw
