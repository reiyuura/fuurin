# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=4001
HOST=127.0.0.1

# ── Database (PostgreSQL 16) ──────────────────────────────
DATABASE_URL=postgresql://fuurin:CHANGE_ME@127.0.0.1:5432/fuurin

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info

# ── Storage ───────────────────────────────────────────────
# StorageProvider driver: 'local' for now.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/uploads

# ── API ───────────────────────────────────────────────────
API_BASE_PATH=/api/v1
API_VERSION=v1